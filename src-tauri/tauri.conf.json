{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paper Reader",
  "version": "0.1.0",
  "identifier": "com.paperreader.app",
  "build": {
    "frontendDist": "app/dist",
    "devUrl": "http://127.0.0.1:1421",
    "beforeDevCommand": "corepack pnpm --dir app dev:tauri --host 127.0.0.1",
    "beforeBuildCommand": "corepack pnpm --dir app build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$HOME/**",
          "D:/**"
        ]
      }
    },
    "windows": [
      {
        "title": "Paper Reader",
        "width": 1440,
        "height": 960,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
